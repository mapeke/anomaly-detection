  {
   "id": 4,
   "type": "stat",
   "title": "Инцидентов за период",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "nids-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT kind, count(*) FROM incidents WHERE $__timeFilter(started_at) GROUP BY kind"
    }
   ]
  },
  {
   "id": 5,
   "type": "table",
   "title": "Журнал инцидентов",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "nids-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT started_at AS \"Начало\", updated_at AS \"Обновлён\", kind AS \"Тип\", host(src) AS \"Источник\", host(dst) AS \"Цель\", round(confidence::numeric,2) AS \"Уверенность\", array_to_string(detectors, ', ') AS \"Детекторы\", notified AS \"Telegram\" FROM incidents WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 200"
    }
   ]
  }
 ],
