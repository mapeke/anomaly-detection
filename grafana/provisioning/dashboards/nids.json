  {
   "id": 3,
   "type": "timeseries",
   "title": "Оценка аномальности (макс. по окну)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "nids-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
